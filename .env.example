# Environment Variables Configuration

# This is the template for environment variables used across the application.
# Copy this file to .env.local and fill in the required values.
# NOTE: .env.local is in .gitignore - never commit it!

# SHARED VARIABLES (both client & server)
# Application execution environment (development, production or test):
NODE_ENV="development"

# PUBLIC VARIABLES (client & server) - Safe to expose to the browser
# Base URL of the application:
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google Analytics ID for tracking user interactions:
NEXT_PUBLIC_GOOGLE_ANALYTICS=""

# Sentry DSN for client-side error monitoring:
NEXT_PUBLIC_SENTRY_DSN=""

# Flag indicating if you are available for hire:
NEXT_PUBLIC_AVAILABLE_FOR_HIRE="false"

# PRIVATE VARIABLES (server only) - Never exposed to the client
# Database connection URL with connection pooling (primary):
DATABASE_URL="postgresql://user:password@localhost:5432/database?schema=public"

# Direct database connection URL for running migrations:
DIRECT_URL="postgresql://user:password@localhost:5432/database?schema=public"

# NextAuth base URL (must match your application URL):
NEXTAUTH_URL="http://localhost:3000":

# Secret key used for encrypting NextAuth sessions and tokens:
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"

# Sentry DSN for server-side error monitoring:
SENTRY_DSN=""

# Sentry authentication token for builds and source map uploads:
SENTRY_AUTH_TOKEN=""

# Google OAuth 2.0 Client ID (from Google Cloud Console):
GOOGLE_ID=""

# Google OAuth 2.0 Client Secret (from Google Cloud Console):
GOOGLE_SECRET=""

# GitHub OAuth App Client ID:
GITHUB_ID=""

# GitHub OAuth App Client Secret:
GITHUB_SECRET=""

# Personal GitHub token for reading public user data (read:user scope):
GITHUB_READ_USER_TOKEN_PERSONAL=""

# Spotify API Client ID (from Spotify Developer Dashboard):
SPOTIFY_CLIENT_ID=""

# Spotify API Client Secret (from Spotify Developer Dashboard):
SPOTIFY_CLIENT_SECRET=""

# Spotify refresh token for renewing access tokens:
SPOTIFY_CLIENT_REFRESH_TOKEN=""

# WakaTime API key for tracking and displaying coding statistics:
WAKATIME_API_KEY=""
